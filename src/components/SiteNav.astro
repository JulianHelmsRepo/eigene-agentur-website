---
const links = [
  { href: "#angebot", label: "Angebot" },
  { href: "#referenzen", label: "Referenzen" },
  { href: "#ablauf", label: "Ablauf" },
  { href: "#faq", label: "FAQ" },
] as const;
---

<nav class="site-nav" data-site-nav aria-label="Hauptnavigation">
  <a class="site-nav__logo" href="#top">Nexora</a>
  <ul class="site-nav__links">
    {
      links.map((link) => (
        <li>
          <a href={link.href}>{link.label}</a>
        </li>
      ))
    }
  </ul>
  <a class="site-nav__cta" href="#kontakt">Erstgespräch</a>
</nav>

<script>
  const nav = document.querySelector<HTMLElement>("[data-site-nav]");
  const hero = document.querySelector<HTMLElement>(".hero");

  if (nav && hero) {
    // Nicht sofort bei Hero-Ende einblenden, sondern erst ein gutes Stück danach,
    // damit genug Abstand zur Angebot-Headline bleibt. Ziel: 65% einer weiteren
    // Hero-Höhe zusätzlichen Scroll. Solange die Seite (noch wenige Sektionen)
    // dafür nicht genug Scroll-Raum hergibt, wird der Wert auf das Verfügbare
    // gedeckelt, damit die Nav nie unerreichbar wird.
    let showAt = 0;

    const updateThreshold = () => {
      const heroHeight = hero.offsetHeight;
      const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
      const roomPastHero = Math.max(0, maxScroll - heroHeight);
      const desiredExtra = heroHeight * 0.65;
      showAt = heroHeight + Math.min(desiredExtra, roomPastHero * 0.6);
    };
    updateThreshold();
    window.addEventListener("resize", updateThreshold);

    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        nav.classList.toggle("is-visible", window.scrollY > showAt);
        ticking = false;
      });
    };

    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  }
</script>

<style>
  .site-nav {
    position: fixed;
    top: clamp(0.75rem, 2vw, 1.5rem);
    left: 50%;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(1rem, 2.5vw, 2rem);
    width: min(90%, 63rem);
    padding: 0.625rem 0.75rem 0.625rem 1.25rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.52);
    border: 1px solid rgba(245, 139, 46, 0.4);
    box-shadow: 0 4px 16px -12px rgba(30, 29, 27, 0.15);
    -webkit-backdrop-filter: blur(20px);
    backdrop-filter: blur(20px);
    transform: translate(-50%, -16px);
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.4s ease,
      transform 0.4s ease;
  }

  .site-nav.is-visible {
    opacity: 1;
    transform: translate(-50%, 0);
    pointer-events: auto;
  }

  .site-nav__logo {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.0625rem;
    color: var(--color-text);
    text-decoration: none;
    white-space: nowrap;
  }

  .site-nav__links {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2vw, 1.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-nav__links a {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.2s ease;
  }

  .site-nav__links a:hover {
    color: var(--color-text);
  }

  .site-nav__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem 1.125rem;
    border-radius: 999px;
    background: var(--color-accent);
    color: var(--color-text);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.9375rem;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.2s ease;
  }

  .site-nav__cta:hover {
    background: var(--color-accent-hover);
  }

  @media (max-width: 720px) {
    .site-nav__links {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-nav {
      transition: none;
    }
  }
</style>

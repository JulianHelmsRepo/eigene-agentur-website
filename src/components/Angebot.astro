---
const cards = [
  {
    size: "lg",
    title: "Website",
    address: "ihre-website.de",
    text: "Klar aufgebaut, schnell, auf jedem Gerät nutzbar – mit den Inhalten, die Ihre Kunden wirklich überzeugen. Auch als Online-Shop möglich.",
    preview: true,
  },
  {
    size: "md",
    title: "Sichtbarkeit",
    address: "google.com/suche",
    text: "Lokale Suche und KI-gestützte Suchassistenten wie ChatGPT oder Google AI Overviews finden Sie nur, wenn Ihre Seite dafür aufgebaut ist. Wir sorgen dafür, dass Sie dort auftauchen, wo gesucht wird.",
    preview: false,
  },
  {
    size: "sm",
    title: "Automatisierung (optional)",
    address: "crm.ihre-firma.de",
    text: "Anfragen automatisch erfassen, Termine vorschlagen, ins CRM übertragen – bis hin zu individuellen Lösungen wie einem KI-Telefonbot, je nach Bedarf.",
    preview: false,
  },
] as const;
---

<section class="angebot" id="angebot" aria-labelledby="angebot-heading">
  <div class="angebot-inner">
    <div class="angebot-intro">
      <h2 id="angebot-heading" class="angebot-heading">
        Eine Website, die für Sie arbeitet – nicht nur schön aussieht
      </h2>
      <p class="angebot-intro-text">
        Die meisten Kunden entscheiden schon vor dem Anruf, wen sie beauftragen, und zwar
        anhand der Website. Ist sie veraltet oder taucht bei Google nicht auf, sind Sie raus.
        Kommt die Anfrage doch an, darf sie nicht im Postfach untergehen.
      </p>
    </div>

    <div class="angebot-row">
      {
        cards.map((card) => (
          <article class={`offer-card offer-card--${card.size}`} data-reveal>
            <div class="offer-card__chrome" aria-hidden="true">
              <span class="offer-card__dot offer-card__dot--red" />
              <span class="offer-card__dot offer-card__dot--yellow" />
              <span class="offer-card__dot offer-card__dot--green" />
              <span class="offer-card__address">{card.address}</span>
            </div>
            <div class="offer-card__body">
              {card.preview && (
                <div class="offer-card__preview" aria-hidden="true">
                  <div class="offer-card__preview-nav">
                    <span class="offer-card__logo-dot" />
                    <span class="offer-card__nav-line" />
                    <span class="offer-card__nav-line" />
                    <span class="offer-card__nav-line" />
                  </div>
                  <div class="offer-card__preview-hero">
                    <span class="offer-card__bar-line offer-card__bar-line--title" />
                    <span class="offer-card__bar-line offer-card__bar-line--sub" />
                    <span class="offer-card__cta-pill" />
                  </div>
                  <div class="offer-card__preview-tiles">
                    <span />
                    <span />
                    <span />
                  </div>
                </div>
              )}
              <h3 class="offer-card-title">{card.title}</h3>
              <p class="offer-card-text">{card.text}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  const cards = document.querySelectorAll<HTMLElement>(".angebot [data-reveal]");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (cards.length && !reduceMotion) {
    gsap.registerPlugin(ScrollTrigger);
    cards.forEach((card) => card.classList.add("will-animate"));

    ScrollTrigger.batch(cards, {
      start: "top 88%",
      once: true,
      onEnter: (batch) => {
        gsap.to(batch, {
          opacity: 1,
          scale: 1,
          duration: 0.55,
          ease: "power2.out",
          stagger: 0.1,
          onComplete: () => {
            batch.forEach((el) => {
              const target = el as HTMLElement;
              target.classList.remove("will-animate");
              target.style.opacity = "";
              target.style.transform = "";
            });
          },
        });
      },
    });

    // Self-hosted Fonts laden asynchron nach; ohne Refresh bleiben ScrollTriggers
    // auf den (noch mit Fallback-Font berechneten) Positionen von vor dem Reflow
    // stehen, wodurch der Trigger im echten Betrieb zu früh/spät oder gar nicht
    // mehr passt, obwohl er in einem schnellen Test unauffällig wirkt.
    document.fonts.ready.then(() => ScrollTrigger.refresh());
    window.addEventListener("load", () => ScrollTrigger.refresh());
  }
</script>

<style>
  .angebot {
    /* nahtlos aus dem Hero-Weiß, wandert bis Kartenbeginn zu warmem Creme */
    background: linear-gradient(180deg, var(--color-background) 0px, var(--color-background-warm) 480px);
    /* zusätzlicher Abstand oben, damit die schwebende Nav nie ohne Luft auf die Headline trifft */
    padding-top: calc(clamp(4rem, 8vw, 7rem) + 90px);
    padding-bottom: clamp(4rem, 8vw, 7rem);
  }

  .angebot-inner {
    max-width: 72rem;
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 6vw, 3rem);
  }

  .angebot-intro {
    max-width: 52rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .angebot-heading {
    margin: 0 0 1rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.75rem, 3.2vw, 2.75rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--color-text);
  }

  .angebot-intro-text {
    margin: 0;
    max-width: 68ch;
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--color-text-muted);
  }

  /* Eine Reihe, gestaffelte Breite: Website ~50%, Sichtbarkeit ~30%, Automatisierung ~20% */
  .angebot-row {
    display: grid;
    grid-template-columns: 4.5fr 3fr 2.5fr;
    align-items: stretch;
    gap: clamp(1rem, 2.5vw, 1.5rem);
  }

  @media (max-width: 900px) {
    .angebot-row {
      grid-template-columns: 1fr;
    }
  }

  /* Die Karte selbst ist das Browser-Fenster, kein verschachteltes Mockup.
     Einheitliches Dark-Mode-Fenster: dunkler Rahmen + Titelleiste, heller Content-Bereich innen.
     Alle drei Karten identisch, Unterscheidung läuft nur über die Breite. */
  .offer-card {
    --chrome: #2a2825;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--color-surface);
    border: 1px solid var(--chrome);
    border-radius: 14px;
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }

  .offer-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 24px 48px -28px rgba(30, 29, 27, 0.22);
  }

  .offer-card.will-animate {
    opacity: 0;
    transform: scale(0.95);
  }

  .offer-card__chrome {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.6rem 0.75rem;
    background: var(--chrome);
    border-bottom: 1px solid var(--chrome);
  }

  .offer-card__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .offer-card__dot--red {
    background: #ff5f57;
  }

  .offer-card__dot--yellow {
    background: #febc2e;
  }

  .offer-card__dot--green {
    background: #28c840;
  }

  .offer-card__address {
    margin-left: 0.5rem;
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.16);
    font-size: 0.625rem;
    color: rgba(255, 255, 255, 0.85);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .offer-card__body {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: clamp(1.25rem, 2.4vw, 1.75rem);
  }

  /* Abstraktes Wireframe, stilisierte Geste statt echtem Screenshot */
  .offer-card__preview {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin-bottom: 1.5rem;
  }

  .offer-card__preview-nav {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .offer-card__logo-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-accent);
    margin-right: auto;
  }

  .offer-card__nav-line {
    width: 28px;
    height: 5px;
    border-radius: 999px;
    background: var(--color-border);
  }

  .offer-card__preview-hero {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .offer-card__bar-line {
    height: 8px;
    border-radius: 999px;
    background: var(--color-border);
  }

  .offer-card__bar-line--title {
    width: 65%;
  }

  .offer-card__bar-line--sub {
    width: 45%;
    height: 6px;
    opacity: 0.7;
  }

  .offer-card__cta-pill {
    margin-top: 0.35rem;
    width: 72px;
    height: 16px;
    border-radius: 999px;
    background: var(--color-accent);
  }

  .offer-card__preview-tiles {
    display: flex;
    gap: 0.5rem;
  }

  .offer-card__preview-tiles span {
    flex: 1;
    height: 28px;
    border-radius: 6px;
    background: var(--color-surface-alt);
    border: 1px solid var(--color-border);
  }

  .offer-card-title {
    margin: 0 0 0.75rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.25rem;
    color: var(--color-text);
  }

  .offer-card-text {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .offer-card {
      transition: none;
    }
  }
</style>
